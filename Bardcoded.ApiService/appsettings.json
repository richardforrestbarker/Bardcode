{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Barcode": "Data Source=bardcode.db",
    "Identity": "Data Source=identity.db"
  },
  "Identity": {
    "Password": {
      "RequiredLength": 8,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true,
      "RequiredUniqueChars": 1
    },
    "Lockout": {
      "DefaultLockoutTimeSpan": "00:05:00",
      "MaxFailedAccessAttempts": 5,
      "AllowedForNewUsers": true
    },
    "User": {
      "RequireUniqueEmail": true
    },
    "SignIn": {
      "RequireConfirmedEmail": false,
      "RequireConfirmedPhoneNumber": false,
      "RequireConfirmedAccount": false
    },
    "DefaultUsers": {
      "Owner": {
        "Password": "Owner@123456"
      },
      "Admin": {
        "Password": "Admin@123456"
      }
    }
  },
  "Cors": {
    "__DefaultCorsPolicy": {
      "Origins": [
        "https://localhost:7256"
      ],
      "AllowAnyHeader": true,
      "AllowAnyMethod": true
    }
  },
  "Application": {
    "Integrations": [
      {
        "Enabled": true,
        "Type": "OpenFoodFactsApiProvider",
        "Url": "https://world.openfoodfacts.net",
        "Path": "api/v2/product/{barcode}.json",
        "Key": "",
        "AllowedBarcodeTypes": [ "EAN_13", "EAN_8", "UPC_A", "UPC_E" ],
        "RateLimit": {
          "Timespan": "00:01:00",
          "Limit": 50
        }
      },
      {
        "Enabled": true,
        "Type": "OpenFoodFactsApiProvider",
        "Url": "https://world.openbeautyfacts.org",
        "Path": "api/v2/product/{barcode}.json",
        "Key": "",
        "AllowedBarcodeTypes": [ "EAN_13", "EAN_8", "UPC_A", "UPC_E" ],
        "RateLimit": {
          "Timespan": "00:01:00",
          "Limit": 50
        }
      },
      {
        "Enabled": true,
        "Type": "UpcDatabaseApiProvider",
        "Url": "https://api.upcdatabase.org",
        "Path": "product/{barcode}",
        "Key": "",
        "AllowedBarcodeTypes": [ "UPC" ],
        "RateLimit": {
          "Timespan": "24:00:00",
          "Limit": 50
        }
      },

      {
        "Enabled": false,
        "Type": "BarcodeLookupApiProvider",
        "Url": "https://api.barcodelookup.com",
        "Path": "v3/products?barcode={barcode}&key=",
        "Key": "",
        "AllowedBarcodeTypes": [ "EAN_13", "EAN_8", "UPC_A", "UPC_E", "ISBN_10", "ISBN_13" ],
        "RateLimit": {
          "Timespan": "00:01:00",
          "Limit": 95
        }
      }
    ],
    "Features": {
      "FetchFromApis": true,
      "UseDatabase": true,
      "UseCache": false,
      "AuthNZ": false
    }
  }
}

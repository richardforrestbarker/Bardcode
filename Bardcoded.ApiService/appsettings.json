{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "__DefaultCorsPolicy": {
      "Origins": [
        "https://localhost:7256"
      ],
      "AllowAnyHeader": true,
      "AllowAnyMethod": true
    }
  },
  "Application": {
    "Integrations": [
      {
        "$type": "UpcDatabaseApiProvider",
        "url": "https://api.upcdatabase.org",
        "path": "product/{barcode}",
        "key": "",
        "allowedBarcodeTypes": [ "UPC" ]
      },
      {
        "$type": "OpenFoodFactsApiProvider",
        "url": "https://world.openfoodfacts.org",
        "path": "api/v2/product/{barcode}.json",
        "key": "",
        "allowedBarcodeTypes": [ "EAN-13", "EAN-8", "UPC-A", "UPC-E" ]
      }
    ],
    "Features": {
      "FetchFromApis": true,
      "UseDatabase": true,
      "UseCache": false
    }
  }
}

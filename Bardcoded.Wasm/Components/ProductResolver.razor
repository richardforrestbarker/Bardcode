@using Bardcoded.Data.Exceptions
@using Bardcoded.Data.Messages
@using Bardcoded.Wasm.Clients
@using Bardcoded.Wasm.Components.Barcode

<h3>Resolve a Product by its Barcode.</h3>

@if (Status.Equals(ScanStatus.Scanning))
{
    <Bardcoded.Wasm.Components.Barcode.BarcodeReader FailureCallback=NoBarcodeScanned
                                                     SuccessCallback="BarcodeSuccessfullyScanned" />
}
else if (Status.Equals(ScanStatus.BarcodeUnreadable))
{
    <p><span id="errorMsg">I wasn't able to read that barcode. Please retry.</span></p>
}
else if (Status.Equals(ScanStatus.Searching))
{
    <div><small>@Result!.BarcodeFormat:</small>&nbsp;@Result.Text</div>
    <p><span id="searchingMsg">Searching for product...</span></p>
}
else if (Status.Equals(ScanStatus.ProductFound))
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">@view!.Name</h5>
            <p class="card-text">@view.Description</p>
            @if (!string.IsNullOrEmpty(view.ProviderType))
            {
                <p><small class="text-muted">Provider: <strong>@view.ProviderType</strong></small></p>
            }
            @if (!string.IsNullOrEmpty(view.ProviderJson))
            {
                <details>
                    <summary>Provider Data</summary>
                    <pre class="bg-light p-2" style="max-height: 200px; overflow-y: auto;">@view.ProviderJson</pre>
                </details>
            }
        </div>
    </div>
    <div class="btn-group mt-3">
        <a class="btn btn-outline-primary" href="update/@view.Code">Update Information</a>
    </div>
}
else if (Status.Equals(ScanStatus.ProductNotFound))
{
    @if (ingestRequest != null)
    {
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@ingestRequest.Name</h5>
                <p class="card-text">@ingestRequest.Description</p>
                @if (!string.IsNullOrEmpty(ingestRequest.ProviderType))
                {
                    <p><small class="text-muted">Provider: <strong>@ingestRequest.ProviderType</strong></small></p>
                }
                @if (!string.IsNullOrEmpty(ingestRequest.ProviderJson))
                {
                    <details>
                        <summary>Provider Data</summary>
                        <pre class="bg-light p-2" style="max-height: 200px; overflow-y: auto;">@ingestRequest.ProviderJson</pre>
                    </details>
                }
            </div>
        </div>
        <div class="btn-group mt-3">
            <button class="btn btn-primary" @onclick="AddToDatabase" disabled="@isAddingToDb">
                @if (isAddingToDb)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Adding...</span>
                }
                else
                {
                    <span>Add To Database</span>
                }
            </button>
        </div>
    }
    else
    {
        <div class="btn-group">
            <a class="btn btn-outline-primary" href="add/@Result.Text">Add To Database (Manual)</a>
        </div>
    }
}
else if (Error != null)
{
    <Notification>
        <Header>
            <strong>Ouf! Something didn't go right.</strong>
        </Header>
        <Message>
            @if (Error is ApiErrorResponseException apiError)
            {
                <p>The server reported a '@apiError.StatusCode' for @apiError.Bard</p>
                @if (apiError.Result != null)
                {
                    <p>
                        @apiError.Result.Title - @apiError.Result.Detail
                    </p>
                }
            }
            else
            {
                <p>@Error.Message</p>
            }
        </Message>
    </Notification>
}
<hr />
<div class="btn-group">
    <button class="btn btn-outline-warning" type="reset" @onclick="Reset">Reset</button>
</div>

@code {
    [Inject] public BardcodeApiHttpClient client { get; set; }

    private bool loading = true;
    private bool isAddingToDb = false;
    private ScanStatus Status { get; set; } = ScanStatus.Scanning;
    /// <summary>
    /// This is the result of we read from the image.
    /// </summary>
    private BarcodeResult? Result { get; set; } = null;
    /// <summary>
    /// if the barcode was found in a network provider, this is the ingest request we got from the API.
    /// </summary>
    private BardcodeInjestRequest? ingestRequest { get; set; } = null;
    /// <summary>
    /// If the barcode was found in the database (or cache), this is the view we got from the API.
    /// </summary>
    private BarcodeView? view { get; set; } = null;
    private Exception? Error { get; set; } = null;

    protected override async Task OnInitializedAsync()
    {
        loading = false;
    }

    public async Task NoBarcodeScanned()
    {
        Status = ScanStatus.BarcodeUnreadable;
        await InvokeAsync(StateHasChanged);
    }

    public async Task BarcodeSuccessfullyScanned(BarcodeResult barcode)
    {
        Status = ScanStatus.Searching;
        Result = barcode;
        await InvokeAsync(StateHasChanged);
        await FetchBarcode(barcode.Text, barcode.BarcodeFormat);
    }

    public async Task FetchBarcode(String barcode, String barcodeType)
    {
        try
        {
            view = await client.GetItem(barcode, barcodeType);
            if (view != null)
            {
                Console.WriteLine($"Product found: {view.Name}");
                Status = ScanStatus.ProductFound;
            }
            else
            {
                Console.WriteLine("Product not found in database, but may have data from provider.");
                // The API now returns the ingest request even if not in DB
                // Check if we got data from the provider
                Status = ScanStatus.ProductNotFound;
            }
        }
        catch (CreateBarcodeRequired create)
        {
            ingestRequest = create.BardcodeInjestRequest;
            Status = ScanStatus.ProductNotFound;
            view = null;
        }
        catch (Exception ex)
        {
            Error = ex;
        }
        await InvokeAsync(StateHasChanged);
    }

    public async Task AddToDatabase()
    {
        if (ingestRequest == null) return;

        isAddingToDb = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await client.CreateItem(ingestRequest);
            if (result != null)
            {
                Console.WriteLine($"Successfully added {ingestRequest.Name} to database");
                Status = ScanStatus.ProductFound;
            }
        }
        catch (Exception ex)
        {
            Error = ex;
            Console.WriteLine($"Failed to add to database: {ex.Message}");
        }
        finally
        {
            isAddingToDb = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public Task Reset()
    {
        Status = ScanStatus.Scanning;
        Result = null;
        ingestRequest = null;
        Error = null;
        isAddingToDb = false;
        return InvokeAsync(StateHasChanged);
    }

    public enum ScanStatus
    {
        Scanning,
        Searching,
        BarcodeUnreadable,
        ProductNotFound,
        ProductFound
    }
}
